// Controlito - esquema de datos.
// Etapa 0: solo la conexion. Los modelos entran en la Etapa 1 (auth)
// y la Etapa 2 (servicios y condiciones).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Conexion sin pooler: Prisma la usa para migraciones.
  directUrl = env("DIRECT_URL")
}
