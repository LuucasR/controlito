NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Neon: URL con pooler para la app, URL directa para las migraciones.
# El parametro pgbouncer=true es OBLIGATORIO: sin el aparece el error
# prepared statement "s0" already exists.
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.sa-east-1.aws.neon.tech/controlito?sslmode=require&pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://user:pass@ep-xxx.sa-east-1.aws.neon.tech/controlito?sslmode=require"

# Origenes permitidos, separados por coma. Nunca * junto con credentials.
CORS_ORIGINS=http://localhost:5555

DEFAULT_TZ=America/Argentina/Buenos_Aires

# Firma de los access tokens. En desarrollo hay un valor por defecto y se puede
# omitir; en produccion es obligatorio y debe tener 32+ caracteres, si no la
# aplicacion se niega a arrancar.
# Generar uno con:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_ACCESS_SECRET=

# Vida del access token en segundos, y del refresh en dias.
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30

# Base contra la que corren los tests e2e, que CREAN Y BORRAN usuarios.
# Debe ser una branch de Neon dedicada, nunca la de produccion. Si queda
# vacia, esas suites se saltean: es preferible saltearlas a arriesgar datos.
E2E_DATABASE_URL=
E2E_DIRECT_URL=
